target_prob <- plogis(0.5 * x1 - 0.3 * x2 + 0.1 * x3)
creditability <- factor(ifelse(runif(n) < target_prob, "Good", "Bad"))
data_sim <- data.frame(x1, x2, x3, x4, x5, cat1, creditability)

# Split data into training and testing sets
